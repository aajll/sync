# Sway configuration, the `sync` repo (see README.md).
# Repo docs: docs/ (index: docs/README.md).
# Per-machine overrides: config.d/ drop-ins and the gitignored .local files.


exec systemctl --user import-environment XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY XDG_SESSION_TYPE

### Variables
#
# Logo key. Use Mod1 for Alt. Mod4 for Super
set $mod Mod4
set $super Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu wofi --show drun -G

# XDG session environment for xdg-open / file-manager handoff
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Screen snipping
# Snip a region: saves to ~/Pictures/Screenshots and copies to the clipboard.
# scripts/screenshot.sh also takes screen/output/window if you want more binds.
bindsym Control+Mod1+s exec $HOME/.config/sway/scripts/screenshot.sh region

# Screen locking
bindsym $super+Ctrl+l exec swaylock -f -i ~/.config/sway/images/wp.png

### Output configuration

# External monitor settings are managed dynamically by scripts/monitor-hotplug.sh.
# It auto-detects the connected output name (e.g. DP-2, HDMI-A-1) and applies
# mode, scale, and adaptive_sync at runtime.

# Wallpaper: wp.png is a symlink managed by config.d/wallpaper + scripts/rotate-wallpaper.sh.
# Rotation pool: images/wallpapers/, or an external folder via WALLPAPER_DIR in host.env.
output * bg ~/.config/sway/images/wp.png fill
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
# Handled by config.d/idle: swayidle via scripts/idle-manager.sh (lock after
# 10 min idle, screen off after 15, lock before suspend). Timings are
# user-configurable in host.env (LOCK_TIMEOUT / SCREEN_OFF_TIMEOUT);
# stay-awake toggle on $super+Ctrl+s.

# Hold an idle inhibitor while any PipeWire stream is active, so swayidle
# doesn't lock the screen during video playback (e.g. Twitch, where the site
# doesn't request the Wake Lock API itself). Optional; skipped if uninstalled.
exec sh -c 'command -v wayland-pipewire-idle-inhibit >/dev/null && exec wayland-pipewire-idle-inhibit'

### Input configuration
# Default compose key. Per-machine override: COMPOSE_KEY in the gitignored
# host.env (copy host.env.example), rendered into a runtime snippet by
# scripts/host-env.sh. Sway silently skips the include until the snippet
# exists, so the default stands on first run. After editing host.env:
# run scripts/host-env.sh, then reload.
exec $HOME/.config/sway/scripts/host-env.sh
set $compose_key compose:menu
include $XDG_RUNTIME_DIR/sway/host_config_snippet
input type:keyboard {
       xkb_layout "gb"
       xkb_model "pc105"
       xkb_options $compose_key
}

# Prevent accidental focus changes from mouse movement
focus_follows_mouse no

# --- Conditional SwayFX Settings ---
# The sway config language does not support shell-like variable assignment or if/then logic.
# Instead, we use a shell script to detect SwayFX and dynamically generate a configuration snippet,
# which is then included.

# 1. Execute the guard script to generate the SwayFX snippet (empty if not SwayFX).
#    Generated under $XDG_RUNTIME_DIR (per-user, 0700, wiped on logout) rather than
#    the world-writable /tmp. sway expands the variable in `include` via wordexp(3).
exec $HOME/.config/sway/scripts/swayfx_guard.sh

# 2. Include the dynamically generated settings. This will be empty for vanilla Sway.
include $XDG_RUNTIME_DIR/sway/swayfx_config_snippet

# 3. Initialize theme on startup and include theme configuration
# Provide default color values as fallback (will be overridden by theme config)
set $bg_color #323232
set $bar_bg_color #323232D9
set $text_color #ffffff
set $inactive_text #d0d0d0
set $border_color #404040
set $indicator_color #5294e2

# Initialize theme (runs asynchronously after Sway starts)
exec $HOME/.config/sway/scripts/toggle_theme.sh init

# Include theme configuration (will override defaults above if file exists).
# Same $XDG_RUNTIME_DIR home as the SwayFX snippet above. At parse time this
# reads the previous run's file (or nothing on a fresh session, falling back to
# the $bg_color defaults above); `toggle_theme.sh init`/`toggle` refresh it.
include $XDG_RUNTIME_DIR/sway/sway_theme_config

# Use pixel borders to disable titlebars for all windows
# (These are standard Sway commands)
default_border pixel 2
default_floating_border pixel 2

# Keep a small gap between windows on both Sway and SwayFX.
gaps inner 5
gaps outer 5


### Key bindings
#
# Basics:
#
    # Start a terminal, browser, or file manager
    bindsym $mod+Return exec $term
    bindsym $mod+Shift+Return exec sh -c 'command -v sensible-browser >/dev/null 2>&1 && exec sensible-browser'
    bindsym $mod+Shift+f exec sh -c 'command -v xdg-open >/dev/null 2>&1 && exec xdg-open "$HOME"'

    # Kill focused window
    bindsym $mod+q kill

    # Start your launcher
    bindsym $mod+space exec $menu

    # Disable the touchpad
    bindsym $mod+Ctrl+t exec $HOME/.config/sway/scripts/toggle-touchpad.sh

    # Toggle theme (Dark/Light mode)
    bindsym $mod+Shift+t exec $HOME/.config/sway/scripts/toggle_theme.sh toggle

    # Quick menus (wofi popups mirroring the bar panels): audio devices,
    # network, bluetooth, power. The power key sits beside $mod+Ctrl+p (the
    # touchpad toggle on Alt+Ctrl+p), different modifiers, deliberate parity
    # with the reference desktop's panel keys.
    bindsym $super+Ctrl+a exec $HOME/.config/sway/scripts/quick-menu.sh audio
    bindsym $super+Ctrl+w exec $HOME/.config/sway/scripts/quick-menu.sh network
    bindsym $super+Ctrl+b exec $HOME/.config/sway/scripts/quick-menu.sh bluetooth
    bindsym $super+Ctrl+p exec $HOME/.config/sway/scripts/quick-menu.sh power
    # Stay awake: suspend the idle lock and screen-off until toggled again
    bindsym $super+Ctrl+s exec $HOME/.config/sway/scripts/toggle-stay-awake.sh

    # Toggle Mako DND (Focus mode)
    bindsym $mod+Shift+m exec $HOME/.config/sway/scripts/toggle-mako-dnd.sh

    # Cycle the desktop wallpaper (random pick from the pool). Rotation is
    # on-demand only; reloads and logins keep the current wallpaper.
    bindsym $mod+Shift+w exec $HOME/.config/sway/scripts/rotate-wallpaper.sh

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right
    # Cycle focus within the current Sway layout (not a global MRU list).
    bindsym Mod1+Tab focus next
    bindsym Mod1+Shift+Tab focus prev

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $mod+Tab workspace next
    bindsym $mod+Shift+Tab workspace prev
    bindsym $mod+Ctrl+Tab workspace back_and_forth
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+Shift+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+t floating toggle
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Ctrl+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+Mod1+s move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
    bindsym $mod+s scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Media keys can arrive either as XF86 keysyms or as raw Linux input codes
    # from a separate consumer-control device, depending on the keyboard.
    # Keep both forms bound and delegate backend-specific work to helper
    # scripts so the same config works on PulseAudio and PipeWire.
    bindsym --locked XF86AudioMute exec $HOME/.config/sway/scripts/volume-control.sh mute
    bindsym --locked XF86AudioLowerVolume exec $HOME/.config/sway/scripts/volume-control.sh down
    bindsym --locked XF86AudioRaiseVolume exec $HOME/.config/sway/scripts/volume-control.sh up
    bindsym --locked XF86AudioMicMute exec $HOME/.config/sway/scripts/volume-control.sh mic-mute
    bindsym --locked XF86MonBrightnessDown exec $HOME/.config/sway/scripts/brightness-control.sh down
    bindsym --locked XF86MonBrightnessUp exec $HOME/.config/sway/scripts/brightness-control.sh up

    # MPRIS transport: any MPRIS player (mpv, browsers, Spotify). Silent when
    # playerctl or a player is absent; --locked keeps them working on the lock screen.
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioPrev exec playerctl previous

    # Hardware fallbacks for devices without working media keys
    bindsym --locked $super+F10 exec $HOME/.config/sway/scripts/volume-control.sh mute
    bindsym --locked $super+F11 exec $HOME/.config/sway/scripts/volume-control.sh down
    bindsym --locked $super+F12 exec $HOME/.config/sway/scripts/volume-control.sh up
    bindsym --locked $super+F7 exec $HOME/.config/sway/scripts/brightness-control.sh down
    bindsym --locked $super+F8 exec $HOME/.config/sway/scripts/brightness-control.sh up
    # External monitor (DDC/CI) brightness
    bindsym --locked $super+Shift+Down exec $HOME/.config/sway/scripts/external-brightness.sh down
    bindsym --locked $super+Shift+Up exec $HOME/.config/sway/scripts/external-brightness.sh up
    bindcode --locked 121 exec $HOME/.config/sway/scripts/volume-control.sh mute
    bindcode --locked 122 exec $HOME/.config/sway/scripts/volume-control.sh down
    bindcode --locked 123 exec $HOME/.config/sway/scripts/volume-control.sh up
    bindcode --locked 232 exec $HOME/.config/sway/scripts/brightness-control.sh down
    bindcode --locked 233 exec $HOME/.config/sway/scripts/brightness-control.sh up
    bindcode --locked 256 exec $HOME/.config/sway/scripts/volume-control.sh mic-mute
    # Special key to capture the whole layout (saved and copied, like the snip)
    bindsym Print exec $HOME/.config/sway/scripts/screenshot.sh screen

# Status bar: Waybar is launched from config.d/waybar.

# Daemon to handle monitor hotplugging (docs/hardware.md)
exec_always ~/.config/sway/scripts/monitor-hotplug.sh

# Optional: Mako notification daemon (only starts if installed)
exec command -v mako && mako || true

# Optional: battery/AC power event watcher (only runs when upower is
# installed and a battery is present, silent on desktops). Polls UPower
# every 30s and fires one notification plus one hook per power transition
# (docs/hooks.md).
exec $HOME/.config/sway/scripts/power-events.sh

# Optional: wob OSD bar for volume/brightness feedback (only starts if
# installed; config in extra/wob/wob.ini). The control scripts write new
# values to $XDG_RUNTIME_DIR/sway/wob.sock via scripts/osd-bar.sh. The fifo
# is held open read-write so a writer closing it can't HUP wob's stdin.
exec sh -c 'command -v wob >/dev/null 2>&1 || exit 0; d="$XDG_RUNTIME_DIR/sway"; mkdir -p "$d"; p="$d/wob.sock"; [ -p "$p" ] || mkfifo "$p"; ini="$HOME/.config/sway/extra/wob/wob.ini"; exec 3<>"$p" || exit 0; if [ -f "$ini" ]; then exec wob -c "$ini" <&3; else exec wob <&3; fi'

# Lid switch triggers
bindswitch --locked lid:on exec ~/.config/sway/scripts/monitor-hotplug.sh --once
bindswitch --locked lid:off exec ~/.config/sway/scripts/monitor-hotplug.sh --once

# Include user configuration snippets
include ~/.config/sway/config.d/*
include /etc/sway/config.d/*

# SSH agent socket
exec sh -c 'ssh-add -l >/dev/null 2>&1 || ssh-add ~/.ssh/github'

# Post-boot hooks (docs/hooks.md). `exec` fires once per session start; a
# reload does not re-run it. Silent no-op until a hook is added.
exec $HOME/.config/sway/scripts/hooks.sh post-boot
