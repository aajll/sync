# Launch Waybar as the desktop status bar.
#
# `exec` (not `exec_always`) so sway reloads don't kill+respawn the bar. Early-boot
# reloads were leaving waybar dead. Theme switches update colors.css, which
# Waybar watches for CSS-only reloads. Do not send SIGUSR2 on theme changes.
#
# Seed a regular colors.css before launch, removing the old symlink so cp
# cannot overwrite a source palette. Run from the Waybar directory because
# Waybar 0.12 resolves watched CSS imports relative to its working directory.
#
# The loop supervises waybar: if it dies abnormally (e.g. a boot-time race
# against still-starting D-Bus services), it is respawned. Capped at 5
# attempts so the loop can't spin forever once the session is gone; a clean
# exit (status 0) ends supervision immediately.
exec sh -c '\
  state=$(cat $HOME/.config/sway/.theme_state 2>/dev/null || echo dark); \
  case $state in dark|light) ;; *) state=dark;; esac; \
  cd "$HOME/.config/sway/waybar" || exit 1; \
  [ ! -L colors.css ] || rm colors.css; \
  cp "colors-${state}.css" colors.css || exit 1; \
  fails=0; \
  while ! waybar -c $HOME/.config/sway/waybar/config.jsonc -s $HOME/.config/sway/waybar/style.css; do \
    fails=$((fails+1)); \
    [ "$fails" -ge 5 ] && break; \
    sleep 1; \
  done; \
'
